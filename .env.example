# Anchor Me Down — headless storefront environment.
# Copy to .env for local/staging. The real .env is never committed.

# App-owned data store (email captures). SQLite for local/staging;
# the schema is Postgres-portable — swap this for a postgresql:// URL
# and change the datasource provider to "postgresql" to move up.
DATABASE_URL="file:./dev.db"

# Operator gate for /admin (single operator). Long, random, private.
ADMIN_PASSWORD="change-me-to-a-long-random-string"

# Public base URL of this deployment (used for metadata/OG URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional: Upstash Redis for the distributed rate limiter.
# When both are set, rate limiting runs on Redis (token bucket, Lua);
# when unset, an in-memory bucket with the identical interface is used.
UPSTASH_REDIS_URL=""
UPSTASH_REDIS_TOKEN=""
